{
  "name": "umkm-kuliner-profile",
  "version": "1.0.0",
  "description": "Backend Node.js + Express untuk UMKM Sari Rasa",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "admin:provision": "node scripts/provision-admin.js",
    "db:backup": "node scripts/database-maintenance.js backup",
    "db:verify": "node scripts/database-maintenance.js verify",
    "db:restore": "node scripts/database-maintenance.js restore",
    "vercel:static:build": "node scripts/build-vercel-static.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --test --test-concurrency=1 tests/backend/*.test.js",
    "test:frontend": "node --test --test-concurrency=1 tests/frontend/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
