# .env.example — Contoh environment variable yang dibutuhkan server ini.
#
# File ini HANYA dokumentasi (bukan file .env asli yang benar-benar dibaca
# otomatis) - project ini SENGAJA tidak memakai package `dotenv` atau
# mekanisme auto-load .env apa pun (zero dependency baru). Untuk benar-benar
# menjalankan server, set environment variable-nya sendiri secara manual di
# shell, misalnya:
#
#   export SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
#   node server.js
#
# atau langsung inline dalam satu baris:
#
#   SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia node server.js
#
# SESSION_SECRET (WAJIB) - dipakai lib/session.js untuk menandatangani
# (HMAC-SHA256) cookie session. Siapa pun yang tahu nilai ini bisa memalsukan
# cookie session untuk mengaku jadi user MANAPUN, termasuk admin - jadi
# nilainya HARUS string acak yang panjang, JANGAN ditebak-tebak/sederhana
# (misal jangan cuma "1" atau "rahasia"), dan JANGAN PERNAH di-commit ke git
# (lihat .gitignore - file .env asli sudah di-ignore, .env.example ini
# dikecualikan karena isinya cuma contoh, bukan secret asli).
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# NODE_ENV (WAJIB untuk development lokal, Phase 3C-4) - server.js memakai
# `secure: process.env.NODE_ENV !== 'development'` saat men-set cookie session
# (lihat server.js). Artinya cookie SELALU dianggap butuh HTTPS (secure)
# KECUALI NODE_ENV persis bernilai 'development' - default ini SENGAJA
# fail-closed (aman), bukan fail-open, supaya lupa/salah set env var tidak
# diam-diam melemahkan keamanan cookie di production.
#
# Konsekuensinya: kalau menjalankan server ini di localhost lewat HTTP biasa
# (bukan HTTPS, situasi development normal), NODE_ENV=development WAJIB
# di-set eksplisit - browser TIDAK PERNAH mengirim cookie yang secure:true
# lewat koneksi non-HTTPS. Tanpa ini, login akan tetap membalas HTTP 200
# (sukses), tapi cookie session TIDAK AKAN PERNAH benar-benar tersimpan/
# terkirim balik oleh browser - requireAuth akan selalu menganggap belum
# login, tanpa pesan error yang jelas menunjuk ke penyebabnya.
#
# Perhatikan: ejaan harus PERSIS 'development' (bukan 'dev' atau singkatan
# lain) - nilai apa pun selain string persis ini akan tetap dianggap
# "butuh secure" (fail-closed), termasuk kalau NODE_ENV cuma diketik salah.
NODE_ENV=development

# DATABASE_PATH (OPSIONAL untuk runtime normal) - bila tidak di-set, server
# tetap memakai data/umkm.db seperti sebelumnya. Automated tests memakai path
# absolut ke SQLite sementara. Untuk mencegah test menyentuh database
# development, NODE_ENV=test WAJIB disertai DATABASE_PATH eksplisit.
#
# Contoh test-only (jangan arahkan ke data/umkm.db):
# NODE_ENV=test DATABASE_PATH=/tmp/umkm-test/test.sqlite npm run test:backend
# DATABASE_PATH=/path/khusus/umkm.db
