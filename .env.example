# Salin file ini menjadi .env untuk development lokal. `npm start` memuat
# .env melalui dukungan bawaan Node.js; tidak ada dependency dotenv.
# .env di-ignore oleh Git. Jangan commit, bagikan, atau log isinya.
#
# SESSION_SECRET (WAJIB) - dipakai lib/session.js untuk menandatangani
# (HMAC-SHA256) cookie session. Siapa pun yang tahu nilai ini bisa memalsukan
# cookie session untuk mengaku jadi user MANAPUN, termasuk admin - jadi
# nilainya HARUS string acak yang panjang, JANGAN ditebak-tebak/sederhana
# (misal jangan cuma "1" atau "rahasia"), dan JANGAN PERNAH di-commit ke git
# (lihat .gitignore - file .env asli sudah di-ignore, .env.example ini
# dikecualikan karena isinya cuma contoh, bukan secret asli).
SESSION_SECRET=

# NODE_ENV (direkomendasikan agar runtime mode eksplisit) - session helper memakai
# `secure: process.env.NODE_ENV === 'production'` saat men-set cookie session
# (lihat lib/session.js). Artinya deployment production tetap mewajibkan
# HTTPS, sedangkan development lokal lewat HTTP dapat memakai cookie session.
#
# Production harus memakai ejaan persis `production` agar cookie diberi flag
# Secure. Development lokal memakai `development`.
NODE_ENV=development

# HOST / PORT - alamat bind dan port Node. Development aman default ke
# 127.0.0.1:3000. Production wajib memilih HOST secara eksplisit sesuai
# private hop dari trusted edge (mis. 127.0.0.1 untuk satu host atau 0.0.0.0
# bila platform private-network memang memerlukannya). Jangan mengekspos Node
# langsung melewati trusted edge. PORT default tetap 3000.
HOST=127.0.0.1
PORT=3000

# FRONTEND_ORIGIN (OPSIONAL untuk development lokal, WAJIB di production) - origin frontend yang
# diizinkan oleh CORS dan wajib cocok dengan header Origin pada mutasi admin.
# Default lokal tetap http://localhost:5500. Set eksplisit pada deployment;
# production wajib memakai HTTPS dan tidak boleh memuat path/query/fragment.
FRONTEND_ORIGIN=http://localhost:5500

# APP_PUBLIC_ORIGIN (OPSIONAL untuk development lokal, WAJIB di production) - trusted origin untuk
# menyusun link reset password. Default mengikuti FRONTEND_ORIGIN. Nilai tidak
# boleh memuat credentials, path, query, atau fragment; production wajib HTTPS.
# Jangan pernah mengambil nilai ini dari Host/Origin/request client.
APP_PUBLIC_ORIGIN=http://localhost:5500

# EMAIL_DELIVERY_MODE - gunakan `disabled` hanya untuk development/test lokal;
# mode ini tidak mengirim email. Production wajib memakai `resend`.
EMAIL_DELIVERY_MODE=disabled

# Wajib saat EMAIL_DELIVERY_MODE=resend. Supply nilai nyata melalui secret
# manager/environment deployment, bukan source code atau file contoh ini.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=SariRasa

# DATABASE_PATH (OPSIONAL untuk development, WAJIB di production) - bila tidak di-set, server
# tetap memakai data/umkm.db seperti sebelumnya. Automated tests memakai path
# absolut ke SQLite sementara. Untuk mencegah test menyentuh database
# development, NODE_ENV=test WAJIB disertai DATABASE_PATH eksplisit.
#
# Contoh test-only (jangan arahkan ke data/umkm.db):
# NODE_ENV=test DATABASE_PATH=/tmp/umkm-test/test.sqlite npm run test:backend
# Production wajib memakai path absolut pada storage persisten.
# DATABASE_PATH=/persistent/path/umkm.db

# DATABASE_BOOTSTRAP_ALLOWED - production saja, hanya untuk pembuatan database
# canonical PERTAMA yang disengaja pada durable DATABASE_PATH yang sudah
# diverifikasi. Biarkan false/hapus setelah bootstrap. Jika file production
# hilang saat flag tidak true, startup gagal alih-alih diam-diam membuat DB baru.
DATABASE_BOOTSTRAP_ALLOWED=false

# PYTHON_SERVICE_URL (OPSIONAL lokal, WAJIB di production) - base URL service FastAPI terpisah yang
# dipanggil Node untuk route analytics dan forecast /api/analytics/*. Default lokalnya adalah
# http://127.0.0.1:8000. Nilai ini bukan secret. Browser tidak memakai URL
# ini secara langsung; Node/Express tetap menjadi backend yang menghadap
# aplikasi. Nilai ini hanya boleh berasal dari konfigurasi operator server,
# bukan request/frontend. Gunakan URL HTTP/HTTPS tanpa credentials, query,
# atau fragment.
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# PYTHON_AI_SERVICE_URL (OPSIONAL) - override kompatibel khusus jalur AI.
# Bila tidak di-set, jalur AI memakai PYTHON_SERVICE_URL yang sama. Nilai ini
# tetap private/server-only dan tidak pernah dikirim ke browser.
# PYTHON_AI_SERVICE_URL=http://127.0.0.1:8000

# SARI_RASA_ANALYTICS_DATASET_PATH (OPSIONAL) - trusted server-side path
# untuk dataset analytics FastAPI. Default development adalah dataset V2
# generated python/data/transactions_ml_v2.csv. Jangan pernah mengambil path
# ini dari query/body/browser. Tests memakai fixture canonical secara eksplisit.
# SARI_RASA_ANALYTICS_DATASET_PATH=/absolute/path/to/transactions_ml_v2.csv

# SARI_RASA_ML_DATASET_PATH (OPSIONAL) - trusted V2 dataset untuk inference
# forecast production dan experimental comparison. Default sama dengan dataset
# generated di python/data/transactions_ml_v2.csv.
# SARI_RASA_ML_DATASET_PATH=/absolute/path/to/transactions_ml_v2.csv

# SARI_RASA_MODEL_ARTIFACT_PATH (OPSIONAL) - trusted production HGB artifact.
# Default: python/models/next_day_quantity_v2.joblib
# SARI_RASA_MODEL_ARTIFACT_PATH=/absolute/path/to/next_day_quantity_v2.joblib

# SARI_RASA_DL_MODEL_ARTIFACT_PATH (OPSIONAL) - trusted experimental MLP artifact.
# Default: python/models/next_day_quantity_mlp_v1.pt
# SARI_RASA_DL_MODEL_ARTIFACT_PATH=/absolute/path/to/next_day_quantity_mlp_v1.pt

# LLM menu assistant (OPSIONAL untuk website dasar, DIPERLUKAN untuk jawaban live
# asisten menu Phase 8) dan acceptance Gemini eksplisit. Pilih model text
# yang saat ini tersedia untuk project/tier Anda di Google AI Studio. Free Tier
# dapat memakai prompt/response untuk peningkatan produk Google: kirim hanya data
# publik atau sintetis, bukan data akun, email pribadi, credential, atau rahasia.
SARI_RASA_LLM_PROVIDER=
SARI_RASA_LLM_MODEL=
SARI_RASA_LLM_API_KEY=
SARI_RASA_LLM_TIMEOUT_SECONDS=10
