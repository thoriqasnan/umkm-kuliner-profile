node_modules/

# File database SQLite adalah hasil GENERATE (dibuat otomatis oleh
# db/database.js saat server pertama kali jalan, lalu diisi seed data).
# Tidak perlu dan tidak sebaiknya ikut di-commit ke git - sama seperti
# node_modules/, siapa pun yang clone project ini akan otomatis dapat
# file .db yang sama persis begitu menjalankan `node server.js`.
data/*.db

# SESSION_SECRET (lihat lib/session.js) WAJIB rahasia - siapa pun yang
# memegang nilainya bisa memalsukan cookie session untuk MENGAKU jadi user
# manapun, termasuk admin. File .env* tempat nilai aslinya biasa disimpan
# TIDAK BOLEH ikut ter-commit ke git - kecuali .env.example yang memang
# sengaja dibuat sebagai dokumentasi (isinya cuma contoh, bukan secret asli).
.env
.env.*
!.env.example
