# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# File database SQLite adalah hasil GENERATE (dibuat otomatis oleh
# db/database.js saat server pertama kali jalan, lalu diisi seed data).
# Tidak perlu dan tidak sebaiknya ikut di-commit ke git - sama seperti
# node_modules/, siapa pun yang clone project ini akan otomatis dapat
# file .db yang sama persis begitu menjalankan `node server.js`.
data/*.db

# SESSION_SECRET (lihat lib/session.js) WAJIB rahasia - siapa pun yang
# memegang nilainya bisa memalsukan cookie session untuk MENGAKU jadi user
# manapun, termasuk admin. File .env* tempat nilai aslinya biasa disimpan
# TIDAK BOLEH ikut ter-commit ke git - kecuali .env.example yang memang
# sengaja dibuat sebagai dokumentasi (isinya cuma contoh, bukan secret asli).
.env
.env.*
!.env.example

# Generated Phase 4C-4 large synthetic dataset (lihat
# python/src/sari_rasa_data/synthetic_data.py). File ini deterministic
# (fixed seed) dan bisa dibuat ulang kapan saja dari generator, jadi
# sengaja TIDAK ikut di-commit. Dataset kecil 30-row canonical di
# python/data/transactions.csv TETAP tracked dan tidak diabaikan di sini.
python/data/transactions_large.csv

# Generated Phase 5 ML-development dataset. It is reproducible from the
# checked-in generator and must remain separate from the canonical fixture.
python/data/transactions_ml.csv
python/data/transactions_ml_v2.csv

# Trusted generated Phase 5E sklearn/joblib model artifacts.
python/models/
